---
import Base from '../../layouts/Base.astro';
import { profile, work } from '../../data/content.js';

export function getStaticPaths() {
  return work.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item: w } = Astro.props;
---

<Base
  title={`${w.name} — ${profile.name}`}
  description={w.oneLiner}
>
  <main>
    <article class="detail page-head">
      <a class="back" href="/#experience">← Back to work</a>
      <h1>{w.name}</h1>
      <p class="detail-role">{w.role}</p>
      {w.metric && <span class="detail-metric">{w.metric}</span>}

      <h2>The problem</h2>
      <p>{w.summary}</p>

      <h2>What I did</h2>
      <p>{w.detail}</p>

      <h2>Stack</h2>
      <div class="tags">
        {w.stack.map((t) => <span class="tag">{t}</span>)}
      </div>
    </article>
  </main>
</Base>
